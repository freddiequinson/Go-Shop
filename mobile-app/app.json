{
  "expo": {
    "name": "GoShop Ghana",
    "slug": "goshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "goshop",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goshop.ghana",
      "infoPlist": {
        "NSCameraUsageDescription": "GoShop needs camera access to scan products and upload images",
        "NSPhotoLibraryUsageDescription": "GoShop needs photo library access to upload product images",
        "NSLocationWhenInUseUsageDescription": "GoShop needs your location to show nearby markets and delivery options"
      }
    },
    "android": {
      "package": "com.goshop.ghana",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GoShop to use your location for delivery and market discovery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GoShop to access your camera for product scanning and image uploads."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b6405813-81bb-4952-949b-835474048842"
      }
    },
    "owner": "quinsons-organization"
  }
}
