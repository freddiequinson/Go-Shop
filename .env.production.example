# Production Environment Variables Template
# Copy this to .env.production and fill in your production values

# Database (Use DigitalOcean Managed PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:port/database

# Security (Generate new secrets for production!)
SECRET_KEY=generate-a-secure-random-secret-key-here
JWT_SECRET_KEY=generate-another-secure-random-jwt-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Password
DB_PASSWORD=your-secure-database-password

# Paystack (Ghana Payment Gateway)
PAYSTACK_SECRET_KEY=your-live-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-live-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co

# Hubtel SMS (Ghana SMS Gateway)
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_BASE_URL=https://smsc.hubtel.com
HUBTEL_SENDER_ID=your-approved-sender-id

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=Go-Shop Ghana

# OAuth2 Configuration (Update redirect URIs to production domain)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=https://yourdomain.com/auth/facebook/callback

# Frontend API URL (Update to your production backend URL)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Application Settings
PROJECT_NAME=GoShopGhana API
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=False
TESTING=False
