# ------------------------------------------------------------------
# GoShopGhana — production env for Droplet deploy. Copy to .env.production
# and fill in real values.  DO NOT commit .env.production.
# ------------------------------------------------------------------

# Public domain (no scheme). Used by Caddy for TLS and by CORS/frontend build.
DOMAIN=goshopghana.com

# --- Restored DigitalOcean MANAGED database ---
# Copy the "Connection string" from DO -> Databases -> your cluster.
# It looks like the line below. KEEP ?sslmode=require (managed DBs force TLS).
# If the string starts with postgres://, change it to postgresql://
DATABASE_URL=postgresql://goshop_user:REPLACE_WITH_MANAGED_DATABASE_PASSWORD@db-host:25060/defaultdb?sslmode=require

# --- App secrets (generate fresh: `openssl rand -hex 32`) ---
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
JWT_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx

# --- DigitalOcean Spaces (product images bucket) ---
SPACES_ACCESS_KEY=xxx
SPACES_SECRET_KEY=xxx
SPACES_NAME=goshop-images
SPACES_REGION=lon1
SPACES_CDN_ENDPOINT=https://goshop-images.lon1.cdn.digitaloceanspaces.com

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=GoShop Ghana

# --- Hubtel SMS (optional) ---
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- AI (optional) ---
GROQ_API_KEY=
