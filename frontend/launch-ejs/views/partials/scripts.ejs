<script>
    // Dynamic Orders link routing based on auth state
    (function () {
        function setOrdersHref() {
            try {
                var ordersLink = document.getElementById('orders-link');
                var ordersLinkMobile = document.getElementById('orders-link-mobile');
                if (!ordersLink) return;
                var isLoggedIn = !!(window.GoShopAuth && typeof window.GoShopAuth.isLoggedIn === 'function' && window.GoShopAuth.isLoggedIn());
                // Also check Next.js auth (Google OAuth / Next.js login)
                if (!isLoggedIn) {
                    try { isLoggedIn = !!(localStorage.getItem('access_token') && localStorage.getItem('user')); } catch(e) {}
                }
                ordersLink.setAttribute('href', isLoggedIn ? '/profile' : '/login');
                if (ordersLinkMobile) {
                    ordersLinkMobile.setAttribute('href', isLoggedIn ? '/profile' : '/login');
                }
            } catch (e) { /* noop */ }
        }
        // Run immediately and also after auth scripts likely initialized
        setOrdersHref();
        window.addEventListener('DOMContentLoaded', setOrdersHref);
    })();
</script>

<script>
    // Mobile: close navbar before navigating/scrolling to section
    (function () {
        function isMobile() {
            return window.matchMedia('(max-width: 991px)').matches;
        }

        function closeMobileNav() {
            try {
                var closeBtn = document.querySelector('.c-header-mobile .c-nav-close');
                if (closeBtn) closeBtn.click();
            } catch (e) { /* noop */ }
        }

        function handleMobileNavClick(event) {
            if (!isMobile()) return;
            var href = this.getAttribute('href') || '';
            // Always retract first
            closeMobileNav();

            // For in-page anchors, prevent default and smooth scroll after closing
            if (href.startsWith('#')) {
                event.preventDefault();
                var target = document.querySelector(href);
                if (target) {
                    setTimeout(function () {
                        if (window.Scroll && typeof window.Scroll.scrollTo === 'function') {
                            window.Scroll.scrollTo(target);
                        } else {
                            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }, 200);
                }
            }
            // For non-anchor links (e.g., auth/profile), let default navigation proceed after retract
        }

        window.addEventListener('DOMContentLoaded', function () {
            var mobileLinks = document.querySelectorAll('.c-header-mobile_bt a.c-nav-link');
            mobileLinks.forEach(function (link) {
                link.addEventListener('click', handleMobileNavClick, false);
            });
        });
    })();
</script>

